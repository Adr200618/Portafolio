---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import perfil from '../data/perfil.json';
import { ruta } from '../utils/ruta';

interface Props { titulo?: string; descripcion?: string; imagen?: string; }

const { titulo, descripcion = perfil.resumen, imagen = perfil.foto } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${perfil.nombre}` : `${perfil.nombre} – ${perfil.rol}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(ruta(imagen), Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>