---
import perfil from '../data/perfil.json';
import { ruta } from '../utils/ruta';

const actual = Astro.url.pathname;
const enlaces = [
  { texto: 'Inicio', href: ruta('/') },
  { texto: 'Sobre mí', href: ruta('/#sobre-mi') },
  { texto: 'Proyectos', href: ruta('/proyectos/') },
  { texto: 'Contacto', href: ruta('/#contacto') },
];
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="container bar">
    <a class="logo" href={ruta('/')}>{perfil.nombre}</a>
    <nav aria-label="Principal">
      <ul>
        {enlaces.map((e) => (
          <li><a href={e.href} aria-current={actual === e.href ? 'page' : undefined}>{e.texto}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>