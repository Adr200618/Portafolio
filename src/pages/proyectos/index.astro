---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProyectoCard from '../../components/ProyectoCard.astro';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base titulo="Proyectos" descripcion="Listado de proyectos web con sus tecnologías, demos y código fuente.">
  <section class="container" aria-labelledby="proyectos-titulo">
    <h1 id="proyectos-titulo">Proyectos</h1>
    <div class="grid">
      {proyectos.map((p) => <ProyectoCard proyecto={p} />)}
    </div>
  </section>
</Base>